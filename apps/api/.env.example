GEMINI_API_KEY=your-gemini-api-key
CARELY_PLACES_ENABLED=false
GOOGLE_MAPS_API_KEY=your-server-restricted-google-maps-key
CARELY_AGENT_SECRET=generate-one-shared-random-secret
CARELY_WEB_ORIGIN=http://localhost:3004
CARELY_API_DATABASE_PATH=./data/carely-api.sqlite

# Inbound calls. This must be the public HTTPS origin serving apps/api.
CARELY_API_PUBLIC_URL=https://your-carely-api.example
TWILIO_AUTH_TOKEN=your-twilio-auth-token
